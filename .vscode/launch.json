{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    //
    // Runs your real Node-RED with this working tree loaded, so breakpoints under telegrambot/ are hit.
    // That needs the package linked into the user directory — without it Node-RED loads the published copy
    // and nothing here is reached:
    //
    //     cd d:/HeinzSeinz/Github/node-red-node-telegrambot && npm link
    //     cd ~/.node-red && npm link node-red-node-telegrambot
    //
    // See dev/README.md.
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Run Node-RED",
            "skipFiles": ["<node_internals>/**"],

            // "program": "C:\\Users\\<you>\\AppData\\Roaming\\npm\\node-red.cmd",
            "program": "C:\\Users\\wind\\AppData\\Roaming\\npm\\node_modules\\node-red\\red.js",
            "cwd": "c:\\users\\wind\\.node-red",
            "args": ["-v"],
            "runtimeArgs": ["--inspect=0.0.0.0"],
            // "runtimeArgs": ["--inspect-brk"],
            "env": { "DEBUG": "" },
            "console": "integratedTerminal"
        }
    ]
}
